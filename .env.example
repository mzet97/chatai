# Valores de APLICAÇÃO (não são limites oficiais dos modelos).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_INPUT_TOKEN_BUDGET=12000
CHAT_API_TIMEOUT_SECONDS=120
CHAT_API_MAX_RETRIES=0

# Django (desenvolvimento local). Gere uma nova chave para cada máquina;
# nunca commite um .env real.
DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
